---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
  title="Projects | Your Name"
  description="QA case studies with approach, artifacts and results."
>
  <h1 class="text-3xl font-bold">Projects</h1>
  <ul class="mt-6 space-y-4">
    {projects.map((p) => (
      <li class="rounded border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
        <h2 class="text-xl font-semibold">
          <a href={`/projects/${p.id}`} class="underline-offset-4 hover:underline">
            {p.data.title}
          </a>
        </h2>
        <p class="mt-1 text-[var(--color-muted)]">{p.data.summary}</p>
        <p class="mt-2 text-sm">{p.data.tools.join(' · ')}</p>
      </li>
    ))}
  </ul>
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Your Name | QA Analyst">
  <h1 class="text-4xl font-bold">Hi, I'm Your Name.</h1>
  <p class="mt-4 text-lg text-[var(--color-muted)]">
    QA analyst focused on test strategy, automation and accessibility. I find the bugs before your
    users do.
  </p>
  <p class="mt-6 flex gap-4">
    <a
      href="/projects"
      class="rounded bg-[var(--color-accent)] px-4 py-2 font-medium text-[var(--color-accent-contrast)]"
    >
      View case studies
    </a>
    <a href="/contact" class="rounded border border-[var(--color-border)] px-4 py-2 font-medium">
      Get in touch
    </a>
  </p>
</Layout>

---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = `${site.name} (${site.role}).` } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Heading and body fonts are preloaded (visible on first paint). The mono font is only used
         for small labels further down, so it is left to load on demand. -->
    <Font cssVariable="--font-cabinet" preload />
    <Font cssVariable="--font-sora" preload />
    <Font cssVariable="--font-jetbrains" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <!--
      Scroll reveal. Inline on purpose: the `js` class must be set before first paint (otherwise
      content would flash), and nothing else depends on a script bundle loading. It does nothing
      when the user prefers reduced motion or the browser lacks IntersectionObserver, so content
      stays visible in those cases.
    -->
    <script is:inline>
      {
        // Scroll storytelling (the Journey section) works with or without reduced motion; CSS turns
        // its animations off. It only needs IntersectionObserver.
        if ('IntersectionObserver' in window) document.documentElement.classList.add('js-scrolly');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce && 'IntersectionObserver' in window) {
          document.documentElement.classList.add('js');
          document.addEventListener('DOMContentLoaded', () => {
            const observer = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (!entry.isIntersecting) continue;
                  entry.target.classList.add('is-revealed');
                  observer.unobserve(entry.target); // reveal once; no re-hiding on scroll back up
                }
              },
              { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
            );
            document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
          });
        }
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:rounded focus:bg-[var(--color-accent)] focus:px-3 focus:py-2 focus:text-[var(--color-accent-contrast)]"
    >
      Skip to content
    </a>
    <Header />
    <!-- Each page or section sets its own width, so the shell can be wide. -->
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Safety net: every link to another website opens in a new tab. Templates already do this
      // through <ExternalLink>, but links written in Markdown (case studies) or added later would
      // not, so this catches them, including ones inserted after the page loads.
      import { EXTERNAL_LINK_ATTRS, NEW_TAB_HINT, isExternalUrl } from '../utils/links';

      const openInNewTab = (link: HTMLAnchorElement) => {
        const href = link.getAttribute('href');
        if (!href || link.hasAttribute('download') || !isExternalUrl(href, location.origin)) return;

        link.target = EXTERNAL_LINK_ATTRS.target;
        const rel = new Set((link.getAttribute('rel') ?? '').split(/\s+/).filter(Boolean));
        rel.add('noopener');
        rel.add('noreferrer');
        link.setAttribute('rel', [...rel].join(' '));

        // Tell screen reader users, unless the template already did.
        if (!link.textContent?.includes(NEW_TAB_HINT.trim())) {
          const hint = document.createElement('span');
          hint.className = 'sr-only';
          hint.textContent = NEW_TAB_HINT;
          link.append(hint);
        }
      };

      const scan = (root: ParentNode) =>
        root.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(openInNewTab);

      scan(document);
      new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          mutation.addedNodes.forEach((node) => {
            if (node instanceof HTMLAnchorElement) openInNewTab(node);
            else if (node instanceof Element) scan(node);
          });
        }
      }).observe(document.body, { childList: true, subtree: true });
    </script>
  </body>
</html>

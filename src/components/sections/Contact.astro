---
import ContactForm from '../ContactForm';
import ExternalLink from '../ExternalLink.astro';
import { site } from '../../data/site';
---

<section id="contact" data-spy aria-labelledby="contact-title" class="px-6 py-24">
  <div class="reveal-stagger mx-auto grid max-w-6xl gap-12 md:grid-cols-2">
    <div data-reveal>
      <h2 id="contact-title" class="text-h2">
        Contact
      </h2>
      <p class="mt-3 text-[var(--color-muted)]">Send a message and I'll get back to you.</p>
      <ul class="mt-8 space-y-2">
        <li>
          <a href={`mailto:${site.email}`} class="underline">
            {site.email}
          </a>
        </li>
        <li>
          <ExternalLink href={site.links.github} class="underline">
            GitHub
          </ExternalLink>
        </li>
        <li>
          <ExternalLink href={site.links.linkedin} class="underline">
            LinkedIn
          </ExternalLink>
        </li>
        <li class="text-[var(--color-muted)]">{site.location}</li>
      </ul>
    </div>
    <!-- client:load: the form needs JS to validate. The rest of the page ships no framework JS. -->
    <div data-reveal>
      <ContactForm client:load />
    </div>
  </div>
</section>

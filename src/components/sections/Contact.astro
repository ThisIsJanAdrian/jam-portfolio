---
import { site } from '../../data/site';
---

<!--
  The closing section, after fazleyrabbi.xyz's "Get in touch": a heading, one line and a single way
  to reach out, a button that opens a new email to the inbox. GitHub and LinkedIn are in the hero.
-->
<section
  id="contact"
  aria-labelledby="contact-title"
  class="px-gutter pt-12 pb-16 sm:pt-20 sm:pb-24"
>
  <div class="reveal-stagger mx-auto flex max-w-6xl flex-col items-start">
    <h2 id="contact-title" data-reveal>
      Get in touch
    </h2>
    <p data-reveal class="mt-3 max-w-xl text-small text-[var(--color-muted)] sm:text-body">
      Have something in mind? I'd be happy to chat.
    </p>
    <a data-reveal href={`mailto:${site.email}`} class="mail-button mt-8">
      Email me
      <span aria-hidden="true">&#8594;</span>
    </a>
  </div>
</section>

<style>
  .mail-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 9999px;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    padding: 0.85rem 1.75rem;
    font-size: var(--text-body);
    font-weight: 600;
    transition:
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.25s;
  }
  /* The same hop as the skill chips and certification cards. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .mail-button:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 22px -10px color-mix(in srgb, var(--color-accent) 70%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mail-button {
      transition: none;
    }
  }
</style>

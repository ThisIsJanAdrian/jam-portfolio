---
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<section id="projects" data-spy aria-labelledby="projects-title" class="px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <h2 id="projects-title" data-reveal class="text-h2">
      Projects
    </h2>
    <p data-reveal class="mt-3 max-w-2xl text-[var(--color-muted)]">
      Things I've built across AI, full-stack and mobile.
    </p>
    <ul class="reveal-stagger mt-10 grid gap-6 sm:grid-cols-2">
      {projects.map((p) => (
        <li
          data-reveal
          class="relative flex flex-col rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-shadow focus-within:shadow-lg hover:shadow-lg"
        >
          <h3 class="text-xl font-semibold">
            {/* Stretched link: the whole card is clickable, with one real link for assistive tech. */}
            <a href={`/projects/${p.id}`} class="after:absolute after:inset-0 after:rounded-2xl">
              {p.data.title}
            </a>
          </h3>
          <p class="mt-2 flex-1 text-[var(--color-muted)]">{p.data.summary}</p>
          <p class="tech-tag mt-4">{p.data.stack.join(' · ')}</p>
          {p.data.award && <p class="mt-3 text-sm font-medium">🏆 {p.data.award}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>

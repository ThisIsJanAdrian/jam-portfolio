---
// PLACEHOLDERS: replace the title and text of each card with your own values.
const values = [
  { title: 'Value one', text: 'A short line about it goes here.' },
  { title: 'Value two', text: 'A short line about it goes here.' },
  { title: 'Value three', text: 'A short line about it goes here.' },
  { title: 'Value four', text: 'A short line about it goes here.' },
];
---

<!--
  Life: what matters outside of work, after timmypidashev.dev/about ("Outside of Programming").
  Four cards side by side on a desktop, two by two on a phone. They share the hop-and-outline
  hover of the other cards (.hover-card in global.css).
-->
<section id="life" data-spy aria-labelledby="life-title" class="px-gutter pt-12 sm:pt-20">
  <div class="mx-auto max-w-6xl">
    <h2 id="life-title" data-reveal>
      Life
    </h2>
    <ul class="reveal-stagger mt-6 grid grid-cols-2 gap-3 sm:mt-8 sm:grid-cols-4 sm:gap-4">
      {values.map((v) => (
        <li
          data-reveal
          class="hover-card rounded-2xl border border-[var(--color-border)] p-4 sm:p-6"
        >
          <h3 class="text-body font-semibold leading-snug">{v.title}</h3>
          <p class="mt-1.5 text-small text-[var(--color-muted)] sm:mt-2">{v.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

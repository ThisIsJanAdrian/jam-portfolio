---
import { Image } from 'astro:assets';
import Terminal from '../Terminal.astro';
import { site } from '../../data/site';
import { roles } from '../../data/roles';
import { shortName } from '../../utils/names';
// Imported from src/assets so Astro resizes and converts it at build time (a ~3000px, 700 KB
// photo becomes small WebP files at the sizes actually displayed).
import headshot from '../../assets/jam2_compressed_2.jpg';

// "Jam Manzanero": the nickname plus the last name (site.name itself is left alone).
const displayName = shortName(site);

// The name never wraps: it is sized to fit its column (see .hero-name below), up to the normal hero
// size. That needs the name's width in "ems": in this font (Cabinet Grotesk 800) a character
// averages about 0.474em, so 0.49 leaves a small safety margin. A longer name just gets smaller.
const NAME_EM_PER_CHARACTER = 0.49;
const nameEm = displayName.length * NAME_EM_PER_CHARACTER;
---

<section id="hero" data-spy class="relative overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_55%_at_75%_25%,color-mix(in_srgb,var(--color-accent)_16%,transparent),transparent)]"
  ></div>

  <!-- Same width and side padding as every other section (a 72rem column). -->
  <div class="box-gutter [--max:76rem] relative grid min-h-[92vh] items-center gap-12 lg:gap-16 lg:content-center lg:items-stretch pt-28 pb-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]">
    <!-- Left: a big portrait in the style of a messaging-app profile (an "online" dot on the avatar),
         with the name centered below it and the role underneath as a status. This column is the
         size container for the name. -->
    <div
      class="hero-col flex flex-col items-center justify-center text-center"
      style={`--name-em: ${nameEm}`}
    >
      <div data-reveal class="hero-avatar relative size-28 sm:size-44">
        <!-- Eager + high priority: this is the largest image above the fold. -->
        <Image
          src={headshot}
          alt={`Portrait of ${site.name}`}
          width={320}
          height={320}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
          class="size-full rounded-full border border-[var(--color-border)] object-cover shadow-xl"
        />
        <span
          aria-hidden="true"
          data-online-dot
          class="absolute right-[4.5%] bottom-[4.5%] size-[20%]"
        >
          <span class="absolute inset-0 rounded-full bg-emerald-400 opacity-60 motion-safe:animate-ping"></span>
          <span class="absolute inset-0 rounded-full bg-emerald-500 ring-4 ring-[var(--color-bg)] sm:ring-[6px]"></span>
        </span>
      </div>

      <h1 data-reveal style="--reveal-delay: 80ms" class="hero-name mt-6 max-w-full">
        {displayName}
      </h1>
      <p
        data-reveal
        data-status
        style="--reveal-delay: 140ms"
        data-roles={JSON.stringify(roles)}
        class="mt-2 flex min-h-[1lh] items-center justify-center text-body font-semibold tracking-widest text-[var(--color-accent)] uppercase"
      >
        <!-- Screen readers get all the roles at once; the revealed words are decoration. The short role
             below (data-role-static) is what shows with reduced motion or without JavaScript.
             Otherwise CSS hides it from the first paint and the line starts blank (see the styles). -->
        <span class="sr-only">{roles.join(', ')}</span>
        <span aria-hidden="true" data-role-static>
          {site.role}
        </span>
        <span aria-hidden="true" data-role-text></span>
      </p>
    </div>

    <!-- Right: just the terminal. -->
    <div data-reveal style="--reveal-delay: 200ms">
      <!-- Floating terminal. [data-float-scroll] makes it react to scrolling a moment late (script below);
           .float-idle / .float-sway / .float-tilt make it drift when still. Separate layers, so their
           transforms never fight each other or the fade-in. -->
      <div data-float-scroll>
        <div class="float-idle">
          <div class="float-sway">
            <div class="float-tilt">
              <Terminal />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The short role (QA • AI • SWE) is plain HTML, so it shows without JavaScript and with reduced
     motion. When the typing will run (the "js" class is only set for JavaScript without reduced
     motion, before the first paint) it is hidden so that it never flashes before the typing starts. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-role-static] {
      display: none;
    }
  }

  /* The role reveal. Two thin bars of the text colour start together in the middle of the word and
     move apart to its two ends, and the word is wiped in between them, from the middle outwards (a
     reveal); later the bars travel back and meet in the middle, wiping the word out (a hide).
     Everything follows one number, --role-p (0 = both bars in the middle, 1 = at the two ends):
     the word is shown between the bars. The word is centred under the name, so the middle never
     moves. (The layer is made by the script below, hence :global.) */
  @property --role-p {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }
  [data-role-text] {
    display: inline-block;
  }
  [data-role-text] :global(.role-layer) {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    --role-p: 0;
  }
  [data-role-text] :global(.role-text) {
    display: inline-block;
    /* Shown between the bars: the same amount is cut off on both sides (the vertical insets are
       negative so that nothing is cut off above or below the letters). */
    clip-path: inset(-0.3em calc((1 - var(--role-p)) * 50%) -0.3em calc((1 - var(--role-p)) * 50%));
  }
  [data-role-text] :global(.role-bar) {
    position: absolute;
    top: 0.1em;
    bottom: 0.1em;
    width: 2px;
    border-radius: 1px;
    background: currentColor;
    opacity: 0;
  }
  /* The left bar goes from the middle to the left end, the right bar from the middle to the right
     end (each 2px wide, so the middle is 50% - 1px). */
  [data-role-text] :global(.role-bar-left) {
    left: calc((1 - var(--role-p)) * (50% - 1px));
  }
  [data-role-text] :global(.role-bar-right) {
    left: calc(50% - 1px + var(--role-p) * (50% - 1px));
  }
  [data-role-text] :global(.is-revealing) {
    animation: role-sweep-in var(--role-ms, 550ms) cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  [data-role-text] :global(.is-hiding) {
    animation: role-sweep-out var(--role-ms, 550ms) cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  [data-role-text] :global(.is-shown) {
    --role-p: 1;
  }
  /* The bars are only there while they travel: they fade in at the start and out at the end. */
  [data-role-text] :global(.is-revealing .role-bar),
  [data-role-text] :global(.is-hiding .role-bar) {
    animation: role-bar-fade var(--role-ms, 550ms) linear forwards;
  }

  @keyframes role-sweep-in {
    from {
      --role-p: 0;
    }
    to {
      --role-p: 1;
    }
  }
  @keyframes role-sweep-out {
    from {
      --role-p: 1;
    }
    to {
      --role-p: 0;
    }
  }
  @keyframes role-bar-fade {
    0% {
      opacity: 0;
    }
    12%,
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* The left column is a size container, so the name (and, on desktop, the avatar) can be sized
     from its width (cqw) and, on desktop, its height (cqh). */
  .hero-col {
    container-type: inline-size;

    /* As large as the display size allows, but shrunk if needed so that it never wraps or
       spills out of the column (never below 1.5rem). */
    --name-size: clamp(1.5rem, min(var(--text-display), calc(100cqw / var(--name-em))), 7.5rem);
  }

  .hero-name {
    white-space: nowrap;
    /* The display role, with its size shrunk to fit the column. */
    font-size: var(--name-size);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    font-weight: var(--text-display--font-weight);
  }

  /* Desktop (two columns): the column's height is the terminal's height. "container-type: size"
     makes the column ignore its own content when the grid measures the row, so the terminal alone
     decides the row height, and the column then stretches to match it. The avatar fills what is
     left after the name, the role and some breathing room, so the whole group (headshot, name and
     role) comes out a little shorter than the terminal, however long the summary is. */
  @media (min-width: 1024px) {
    .hero-col {
      container-type: size;
    }

    .hero-avatar {
      /* group = avatar + name (line-height 1.05) + gaps and role line (3.6rem) + padding (3rem) */
      --avatar: clamp(
        7rem,
        min(100cqw, calc(100cqh - var(--text-display--line-height) * var(--name-size) - 6.6rem)),
        20rem
      );
      width: var(--avatar);
      height: var(--avatar);
    }
  }
</style>

<script>
  // Floating terminal, scroll part: the terminal reacts to scrolling a moment late. It follows the
  // page's scroll position with a delay, so while you scroll it hangs a little behind (lower than
  // it should be when scrolling down), and after you stop it drifts into place. How far behind is
  // capped (MAX_LAG_PX), so a fast scroll never leaves it far away.
  const layer = document.querySelector<HTMLElement>('[data-float-scroll]');
  const hero = document.getElementById('hero');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (layer && hero) {
    // On a phone the terminal is nearly as wide as the screen and scrolling is by finger, so it
    // trails far less and catches up sooner: a long lag there reads as stutter, not as float.
    const phone = window.matchMedia('(max-width: 639px)');
    const lagPx = () => (phone.matches ? 12 : 40); // the furthest it appears to trail
    const follow = () => (phone.matches ? 0.4 : 0.15); // share of the gap closed per frame at 60fps

    let smoothed = window.scrollY; // the delayed scroll position the terminal is "at"
    let lastTime = performance.now();
    let frame = 0;
    let heroVisible = true;

    new IntersectionObserver(([entry]) => (heroVisible = entry.isIntersecting)).observe(hero);

    const setOffset = (pixels: number) => {
      layer.style.transform = pixels ? `translate3d(0, ${pixels.toFixed(2)}px, 0)` : '';
    };

    const step = (time: number) => {
      frame = 0;
      const y = window.scrollY;
      const dt = Math.min(64, time - lastTime);
      lastTime = time;

      if (reduceMotion.matches || !heroVisible) {
        smoothed = y;
        setOffset(0);
        return;
      }

      // Chase the real scroll position, closing a fixed share of the gap each frame (frame-rate
      // independent), but never lagging further than CHASE_LIMIT_PX.
      const MAX_LAG_PX = lagPx();
      const CHASE_LIMIT_PX = MAX_LAG_PX * 1.5; // so catching up after a huge jump stays quick
      const share = 1 - Math.pow(1 - follow(), dt / 16.67);
      smoothed += (y - smoothed) * share;
      let lag = y - smoothed; // positive while scrolling down
      lag = Math.max(-CHASE_LIMIT_PX, Math.min(CHASE_LIMIT_PX, lag));
      smoothed = y - lag;

      if (Math.abs(lag) < 0.05) {
        smoothed = y;
        setOffset(0);
        return; // settled: stop the loop until the next scroll
      }

      // tanh eases the lag towards MAX_LAG_PX instead of hitting a hard wall.
      setOffset(MAX_LAG_PX * Math.tanh(lag / MAX_LAG_PX));
      frame = requestAnimationFrame(step);
    };

    window.addEventListener(
      'scroll',
      () => {
        if (frame) return;
        lastTime = performance.now();
        frame = requestAnimationFrame(step);
      },
      { passive: true },
    );
  }
</script>

<script>
  // The role under the name is revealed by two thin bars: they start together in the middle of the
  // word and move apart to its two ends, wiping the word in between them; after a pause they travel
  // back and meet in the middle, wiping the word out; then the next role is revealed. (The bar is plain CSS, see
  // the styles; this script only switches the states.) The word is centred, so the middle of the
  // line never moves. The state is also written to data-role-state and the role to
  // data-current-role. Reduced motion (even if switched on later) stops it; CSS then shows the
  // short role again.
  const status = document.querySelector<HTMLElement>('[data-status]');
  const text = status?.querySelector<HTMLElement>('[data-role-text]');
  const roles: string[] = JSON.parse(status?.dataset.roles ?? '[]');

  if (status && text && roles.length) {
    const SWEEP_MS = 250; // the bars travelling from the middle to the ends (or back)
    const HOLD_MS = 1750; // a role stays this long once it is revealed

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer = 0;
    let index = -1;
    let layer: HTMLElement | null = null;

    const setState = (state: 'revealing' | 'shown' | 'hiding') => {
      status.dataset.roleState = state;
      if (layer) layer.className = 'role-layer is-' + state;
    };

    // Reveal the next role: the bar crosses left to right, then the word stays.
    const reveal = () => {
      index = (index + 1) % roles.length;
      layer = document.createElement('span');
      const word = document.createElement('span');
      word.className = 'role-text';
      word.textContent = roles[index];
      // Two thin bars, one going to each end of the word.
      const left = document.createElement('span');
      left.className = 'role-bar role-bar-left';
      const right = document.createElement('span');
      right.className = 'role-bar role-bar-right';
      layer.append(word, left, right);
      text.replaceChildren(layer);
      status.dataset.currentRole = roles[index];
      setState('revealing');
      timer = window.setTimeout(() => {
        setState('shown');
        timer = window.setTimeout(hide, HOLD_MS);
      }, SWEEP_MS);
    };

    // Hide the role: the bar crosses right to left, then the next role is revealed.
    const hide = () => {
      setState('hiding');
      timer = window.setTimeout(reveal, SWEEP_MS);
    };

    const start = () => {
      window.clearTimeout(timer);
      status.style.setProperty('--role-ms', SWEEP_MS + 'ms');
      index = -1;
      reveal(); // the first role is revealed at once
    };

    const stop = () => {
      window.clearTimeout(timer);
      text.textContent = '';
      layer = null;
      delete status.dataset.currentRole;
      delete status.dataset.roleState;
    };

    const sync = () => (reduceMotion.matches ? stop() : start());
    reduceMotion.addEventListener('change', sync);
    sync();
  }
</script>

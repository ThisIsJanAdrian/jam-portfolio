---
import { experience, formatPeriod } from '../../data/profile';
---

<!-- Editorial section: a narrow column for comfortable reading, inside the wide page shell. -->
<section id="experience" data-spy aria-labelledby="experience-title" class="px-6 py-24">
  <div class="mx-auto max-w-2xl">
    <h2 id="experience-title" data-reveal class="text-h2">
      Experience
    </h2>
    <ol class="mt-8 space-y-10 border-l border-[var(--color-border)] pl-6">
      {experience.map((job) => (
        <li data-reveal class="relative">
          <span
            aria-hidden="true"
            class="absolute top-2 -left-[1.85rem] size-2.5 rounded-full bg-[var(--color-accent)]"
          />
          <h3 class="text-lg font-semibold">{job.role}</h3>
          <p>{job.company}</p>
          <p class="metric-badge text-[var(--color-muted)]">{formatPeriod(job.start, job.end)}</p>
          {job.highlights && job.highlights.length > 0 && (
            <ul class="mt-3 list-disc space-y-1 pl-6">
              {job.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

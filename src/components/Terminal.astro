---
import ExternalLink from './ExternalLink.astro';
import TerminalPrompt from './TerminalPrompt.astro';
import { bio } from '../data/profile';
import { site } from '../data/site';

// Padding gives each link a comfortable tap target (at least 24px tall); the focus ring is white
// because the page-wide blue one is invisible on this dark card.
const linkClass =
  'inline-block rounded px-0.5 py-1.5 underline decoration-slate-500 underline-offset-4 hover:text-white hover:decoration-white focus-visible:outline-white';

// The text comes from `bio` in src/data/profile.ts, so editing it there updates this card.
// The card is always dark (like a real terminal), in both the light and dark page themes.
---

<!--
  The summary. There is no visible "About" heading; the screen-reader-only <h2> keeps the page
  outline valid and gives this region a name. The window chrome and the prompt lines are
  decoration, so they are hidden from assistive technology (aria-hidden).
-->
<section
  aria-labelledby="about-title"
  data-terminal
  class="overflow-hidden rounded-2xl border border-slate-800 bg-[#080C14] shadow-2xl"
>
  <h2 id="about-title" class="sr-only">
    About
  </h2>

  <div
    aria-hidden="true"
    class="flex items-center gap-2 border-b border-slate-800/80 bg-slate-950 px-4 py-3"
  >
    <span class="inline-block size-3 rounded-full bg-red-500/80"></span>
    <span class="inline-block size-3 rounded-full bg-yellow-500/80"></span>
    <span class="inline-block size-3 rounded-full bg-green-500/80"></span>
    <span class="ml-2 font-mono text-xs text-slate-400 sm:text-sm">about.md</span>
  </div>

  <!-- Terminal text: 12px on phones, 15px from 640px up, 16px from 1024px up. Slate-200 (instead of
       300) and relaxed line spacing keep the monospace text easy to read. -->
  <div class="space-y-3 p-5 font-mono text-[12px] leading-relaxed tracking-normal text-slate-200 sm:p-6 sm:text-[15px] lg:text-base">
    <TerminalPrompt command="type summary.md" />
    <p class="tracking-normal">{bio.intro}</p>
    <p class="tracking-normal">{bio.closing}</p>
    <TerminalPrompt>
      <span class="terminal-cursor ml-2 inline-block h-4 w-2 translate-y-0.5 bg-cyan-400"></span>
    </TerminalPrompt>
  </div>

  <!-- Where to find me: styled like a terminal status bar. GitHub and LinkedIn open in a new tab. -->
  <div class="flex flex-wrap items-center gap-x-5 gap-y-1 border-t border-slate-800/80 bg-slate-950 px-4 py-1.5 font-mono text-xs text-slate-300 sm:px-6 sm:text-sm">
    <ExternalLink href={site.links.github} class={linkClass}>
      GitHub
    </ExternalLink>
    <ExternalLink href={site.links.linkedin} class={linkClass}>
      LinkedIn
    </ExternalLink>
    <a href={`mailto:${site.email}`} class={linkClass}>
      Email
    </a>
  </div>
</section>

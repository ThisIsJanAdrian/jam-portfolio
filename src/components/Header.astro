---
import { site } from '../data/site';

// `section` is the id of the home-page section a link stands for ("Jam" = the hero). Links are
// absolute so they also work from case-study pages; "/#" scrolls to the top without a reload.
const links = [
  { href: '/#', section: 'hero', label: site.nickname },
  { href: '/#projects', section: 'projects', label: 'Projects' },
  { href: '/#journey', section: 'journey', label: 'Journey' },
  { href: '/#skills', section: 'skills', label: 'Skills' },
];

// The active link only changes its text colour; the coloured pill behind it is the sliding
// [data-nav-indicator] element, so it can glide from one link to another instead of fading.
// Tighter padding below `sm` keeps the links and the theme toggle on a 360px phone.
const linkClass =
  'relative z-10 block rounded-full px-1 py-1.5 text-small transition-colors duration-300 motion-reduce:transition-none sm:px-3 [&:not([aria-current])]:hover:bg-[var(--color-surface)] aria-[current=location]:text-[var(--color-text)]';
---

<!--
  Floating "glass" pill. pointer-events are off on the full-width wrapper so it never blocks
  clicks on the page behind it. The fill is mostly opaque so text contrast stays safe over
  whatever scrolls underneath.
-->
<header class="pointer-events-none fixed inset-x-0 top-4 z-50 flex items-center justify-center gap-2 px-4">
  <nav
    aria-label="Main"
    class="pointer-events-auto flex max-w-full items-center overflow-hidden rounded-full border border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-bg)_82%,transparent)] px-1 py-1.5 sm:px-2 shadow-lg backdrop-blur-md"
  >
    <div class="relative">
      <span
        aria-hidden="true"
        data-nav-indicator
        class="nav-indicator pointer-events-none absolute inset-y-0 left-0 w-0 rounded-full bg-[var(--color-pill)] opacity-0"
      ></span>
      <ul class="flex items-center gap-0.5 sm:gap-1">
        {links.map((l) => (
          <li>
            <a href={l.href} data-section={l.section} class={linkClass}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- A separate round button beside the pill: the same glass, with a sun and a moon that swap. -->
  <button
    type="button"
    data-theme-toggle
    aria-pressed="false"
    aria-label="Dark mode"
    class="theme-toggle pointer-events-auto relative grid size-10 shrink-0 place-items-center rounded-full border border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-bg)_82%,transparent)] shadow-lg backdrop-blur-md"
  >
    <svg
      class="icon sun"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
    <svg
      class="icon moon"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </svg>
  </button>
</header>

<style>
  /* The toggle shows the moon on a light page (press for dark) and the sun on a dark one. The two
     icons sit on top of each other and swap by turning and fading. */
  .theme-toggle {
    transition:
      border-color 0.25s,
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .theme-toggle:hover {
    border-color: var(--color-muted);
  }
  .icon {
    position: absolute;
    transition:
      opacity 0.3s,
      transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  .moon {
    opacity: 1;
    transform: none;
  }
  :global(:root[data-theme='dark']) .sun {
    opacity: 1;
    transform: none;
  }
  :global(:root[data-theme='dark']) .moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      opacity: 1;
      transform: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      opacity: 0;
      transform: rotate(90deg) scale(0.5);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .theme-toggle:hover {
      transform: translateY(-2px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .icon {
      transition: none;
    }
  }

  /*
   * Slide only for people who have not asked for reduced motion; otherwise the highlight jumps.
   * EDIT HERE to change the feel: the easing curve, and the default duration (350ms). The script
   * sets --slide-ms per move so that longer jumps take a little longer.
   */
  @media (prefers-reduced-motion: no-preference) {
    .nav-indicator[data-ready] {
      /* "Ease-out-back": overshoots the target by ~4% and settles. Use cubic-bezier(0.4, 0, 0.2, 1)
         for a plain ease, or raise the 1.35 for a bouncier overshoot (1.56 is about 10%). */
      --slide-ease: cubic-bezier(0.3, 1.2, 0.6, 1);
      transition:
        transform var(--slide-ms, 350ms) var(--slide-ease),
        width var(--slide-ms, 350ms) var(--slide-ease),
        opacity 200ms ease;
    }
  }
</style>

<script>
  // Light/dark toggle: flips the theme the page is showing now (the saved choice, else the OS
  // setting), and remembers it. The inline script in Layout.astro applies it before first paint.
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (toggle) {
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
    const isDark = () => {
      const set = document.documentElement.dataset.theme;
      return set ? set === 'dark' : systemDark.matches;
    };
    const sync = () => toggle.setAttribute('aria-pressed', String(isDark()));
    sync();
    systemDark.addEventListener('change', sync);
    toggle.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // storage can be blocked (private windows): the choice then lasts only for this visit
      }
      sync();
    });
  }
</script>

<script>
  // Highlight the nav link for the section in the middle of the viewport, and slide the
  // highlight pill under it.
  const links = document.querySelectorAll<HTMLAnchorElement>('a[data-section]');
  const spied = document.querySelectorAll<HTMLElement>('[data-spy]');
  const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]');

  // --- Tuning knobs for the slide -------------------------------------------------------------
  const MIN_MS = 350; // fastest slide (neighbouring links)
  const MAX_MS = 700; // slowest slide (far apart links)
  const MS_PER_PX = 0.6; // extra time per pixel travelled
  const SETTLE_MS = 150; // how long scrolling must be quiet before the page counts as "arrived"
  // ---------------------------------------------------------------------------------------------

  let placed = false;
  let lastX = 0;

  const moveIndicator = () => {
    if (!indicator) return;
    const active = document.querySelector<HTMLAnchorElement>(
      'a[data-section][aria-current="location"]',
    );
    if (!active) {
      indicator.style.opacity = '0';
      return;
    }
    const x = active.offsetLeft;
    if (placed) {
      const ms = Math.min(MAX_MS, Math.max(MIN_MS, 250 + Math.abs(x - lastX) * MS_PER_PX));
      indicator.style.setProperty('--slide-ms', `${Math.round(ms)}ms`);
    }
    lastX = x;
    indicator.style.width = `${active.offsetWidth}px`;
    indicator.style.transform = `translateX(${x}px)`;
    indicator.style.opacity = '1';

    if (!placed) {
      // Turn the slide on only after the first placement, so the pill does not glide in from the
      // left edge on page load.
      placed = true;
      requestAnimationFrame(() =>
        requestAnimationFrame(() => indicator.setAttribute('data-ready', '')),
      );
    }
  };

  const setActive = (id: string) => {
    links.forEach((link) => {
      if (link.dataset.section === id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
    moveIndicator();
  };

  if (links.length && spied.length) {
    // After a nav click the page smooth-scrolls past every section in between. While that is
    // happening we ignore the scroll position and go straight to the clicked link, so the pill
    // makes one clean slide instead of hopping through each section on the way.
    let travelling = false;
    let settleTimer: number | undefined;

    // At the very bottom of the page the last section is the one being read, even when it is too
    // short to reach the middle of a tall screen (a Contact section that is just a button).
    const lastId = spied[spied.length - 1].id;
    const atBottom = () =>
      window.scrollY > 0 &&
      window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;

    const sectionAtMiddle = () => {
      const y = window.innerHeight * 0.5;
      for (const section of spied) {
        const r = section.getBoundingClientRect();
        if (r.top <= y && r.bottom > y) return section.id;
      }
      return null;
    };

    // The section the last nav click was heading to (null when the user is just scrolling).
    let target: string | null = null;

    const arrive = () => {
      travelling = false;
      const destination = target ? document.getElementById(target) : null;
      target = null;
      // Keep the clicked link while its section is still on screen in the upper half. Short
      // sections (like a single job) leave the middle of a tall screen inside the NEXT section, so
      // trusting the middle alone would flip the highlight away from the link that was clicked.
      if (destination) {
        const r = destination.getBoundingClientRect();
        if (r.top < window.innerHeight * 0.5 && r.bottom > 0) return;
      }
      const id = atBottom() ? lastId : sectionAtMiddle(); // the user scrolled somewhere else meanwhile
      if (id) setActive(id);
    };

    const waitForArrival = () => {
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(arrive, SETTLE_MS);
    };

    window.addEventListener(
      'scroll',
      () => {
        if (travelling) waitForArrival();
        else if (atBottom()) setActive(lastId);
      },
      { passive: true },
    );

    links.forEach((link) =>
      link.addEventListener('click', (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return; // let "open in new tab" and friends behave normally
        }
        travelling = true;
        target = link.dataset.section ?? null;
        setActive(link.dataset.section!);
        waitForArrival(); // covers the case where the page does not need to scroll at all
      }),
    );

    const observer = new IntersectionObserver(
      (entries) => {
        if (travelling) return;
        if (atBottom()) return setActive(lastId);
        for (const entry of entries) if (entry.isIntersecting) setActive(entry.target.id);
      },
      // A thin band across the middle of the viewport decides the active section.
      { rootMargin: '-45% 0px -50% 0px' },
    );
    spied.forEach((section) => observer.observe(section));
  }

  // Keep the pill aligned if the nav changes size (window resize, font loading).
  if (indicator?.parentElement) new ResizeObserver(moveIndicator).observe(indicator.parentElement);
</script>

---
import { site } from '../data/site';

// `id` matches the section id on the home page. Links are absolute (/#id) so they also work
// from case-study pages.
const links = [
  { id: 'about', label: 'About' },
  { id: 'projects', label: 'Projects' },
  { id: 'background', label: 'Background' },
  { id: 'contact', label: 'Contact' },
];

const linkClass =
  'block rounded-full px-3 py-1.5 text-sm font-medium transition-colors hover:bg-[var(--color-surface)] aria-[current=location]:bg-[var(--color-accent)] aria-[current=location]:text-[var(--color-accent-contrast)]';
---

<!--
  Floating "glass" pill. pointer-events are off on the full-width wrapper so it never blocks
  clicks on the page behind it. The fill is mostly opaque so text contrast stays safe over
  whatever scrolls underneath.
-->
<header class="pointer-events-none fixed inset-x-0 top-4 z-50 flex justify-center px-4">
  <nav
    aria-label="Main"
    class="pointer-events-auto flex max-w-full items-center gap-1 rounded-full border border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-bg)_82%,transparent)] px-2 py-1.5 shadow-lg backdrop-blur-md"
  >
    <!-- "/#" instead of "/": on the home page this scrolls to the top without reloading it. -->
    <a href="/#" class={`${linkClass} hidden font-semibold sm:block`}>
      {site.nickname}
    </a>
    <ul class="flex items-center gap-1">
      {links.map((l) => (
        <li>
          <a href={`/#${l.id}`} data-section={l.id} class={linkClass}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // Highlight the nav link for the section in the middle of the viewport.
  const links = document.querySelectorAll<HTMLAnchorElement>('a[data-section]');
  const spied = document.querySelectorAll<HTMLElement>('[data-spy]');

  if (links.length && spied.length) {
    const setActive = (id: string) => {
      links.forEach((link) => {
        if (link.dataset.section === id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) if (entry.isIntersecting) setActive(entry.target.id);
      },
      // A thin band across the middle of the viewport decides the active section.
      { rootMargin: '-45% 0px -50% 0px' },
    );
    spied.forEach((section) => observer.observe(section));
  }
</script>
